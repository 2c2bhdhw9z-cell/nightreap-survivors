{
  "expo": {
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.nightreap_k7q2.runable",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#141320"
      },
      "edgeToEdgeEnabled": true
    },
    "extra": {
      "apiUrl": "https://nightre-oqwfyiy-preview-4200.runable.site/",
      "applicationId": "nightre-oqwfyiy",
      "runableAuthIssuer": "https://api.runable.com/api/auth"
    },
    "ios": {
      "bundleIdentifier": "com.nightreap_k7q2.runable",
      "supportsTablet": true,
      "infoPlist": {
        "CADisableMinimumFrameDuration": true
      }
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#141320"
    },
    "name": "Nightreap Survivors",
    "slug": "nightreap-survivors",
    "version": "1.0.0",
    "scheme": "runable-nightre-oqwfyiy",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-localization"
    ]
  }
}
